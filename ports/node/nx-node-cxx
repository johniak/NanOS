#!/usr/bin/env bash
# nx-node-cxx — C++ compiler wrapper for the NanOS Node/V8 cross build. See ports/node/nx-node-cc for
# the rationale; this one drives the C++ cross compiler.
#
# It strips driver flags the nanos g++ rejects (-pthread: threads live in libc; -rdynamic: a static
# .nxe has no dynamic symbol table). The C++ static-constructor bracketing that node needs is done in
# the linker script the toolchain uses by default (nx.ld, staged with the __nx_{init_array,ctors}_
# {start,end} collection by the `make node` target) — NOT injected here, because ld places the ctor
# section differently for a -T script than for the default script (a -T copy resets the collected
# section's LMA to the base and overlaps .nxheader; the default-script path does not).
set -u
: "${NX_BASE:=x86_64-nanos-g++}"

args=()
for a in "$@"; do
	case "$a" in
		-pthread) ;;    # threads live in libc on NanOS; the nanos g++ rejects the driver flag
		-rdynamic) ;;   # no dynamic symbol table in a static .nxe; the flag is meaningless
		*) args+=("$a") ;;
	esac
done
exec "$NX_BASE" "${args[@]}"
