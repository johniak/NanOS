/*
 * kexports.def — the kernel's symbol export list for loadable modules (nkext), the
 * EXPORT_SYMBOL of NanOS. SINGLE SOURCE OF TRUTH: KernelExports.cpp expands it to build the
 * runtime resolver table, and the Makefile expands it (awk) to generate the kext import
 * stub (`__imp_<name>` slots + thunks in section .nxlib.kernel). A module that imports a name
 * NOT listed here fails to load (loud error) — never resolved silently.
 *
 * X-macro: each KX(name) names one exported, stable extern "C" kernel symbol.
 */
KX(knx_malloc)
KX(knx_free)
KX(knx_log)
KX(knx_uptime_us)
KX(knx_ram_top)
KX(knx_register_irq)
KX(knx_feed_scancode)
KX(knx_add_input_dev)
KX(knx_pci_find)
KX(knx_pci_bar)
KX(knx_pci_bar_size)
KX(knx_pci_bar_is_io)
KX(knx_pci_irq)
KX(knx_pci_enable_bus_master)
KX(knx_pci_cfg_read32)
KX(knx_pci_cfg_write32)
KX(knx_map_mmio)
KX(knx_dma_alloc)
KX(knx_add_net_dev)
KX(knx_netif_rx)
KX(knx_register_msi)
KX(knx_thread_spawn)
KX(knx_thread_should_stop)
KX(knx_thread_stop)
KX(knx_thread_yield)
KX(knx_thread_msleep)
KX(knx_run_after_scheduler)
KX(knx_file_read)
KX(knx_file_append)
KX(knx_set_panic_sink)
KX(knx_rcu_synchronize)
KX(knx_fb_set_backing)
KX(knx_fb_start_present)
KX(knx_boot_fb)
KX(knx_drm_register)
KX(knx_getpid)
